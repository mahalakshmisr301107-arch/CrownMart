<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page import="com.crownmart.app.filter.AuthFilter" %>
<%@ page import="com.crownmart.app.model.User" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>CrownMart</title>
    <style>
        :root {
            --bg: #14161a;
            --surface: #1e2128;
            --surface-hover: #262a33;
            --border: #2e323c;
            --gold: #c9a24b;
            --gold-hover: #ddb85f;
            --text: #eae7e0;
            --text-muted: #9a9a9e;
            --success-bg: #16261c;
            --success-border: #2f5c3e;
            --success-text: #8fd6a3;
            --error-bg: #2a1818;
            --error-border: #6b2c2c;
            --error-text: #e39b9b;
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Georgia, 'Times New Roman', serif;
            margin: 0;
            background: var(--bg);
            color: var(--text);
            letter-spacing: 0.01em;
        }
        header {
            background: linear-gradient(180deg, #1a1c22 0%, #16181d 100%);
            color: var(--text);
            padding: 18px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
        }
        header a {
            color: var(--text-muted);
            text-decoration: none;
            margin-right: 20px;
            font-weight: 500;
            font-size: 14px;
            transition: color 0.2s ease;
        }
        header a:hover { color: var(--gold); }
        header .brand {
            font-size: 24px;
            font-weight: 600;
            margin-right: 40px;
            color: var(--gold);
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        main { max-width: 960px; margin: 32px auto; padding: 0 16px; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 18px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.35);
            transition: border-color 0.2s ease, transform 0.15s ease;
        }
        .product-grid .card:hover {
            border-color: var(--gold);
            transform: translateY(-2px);
        }
        .flash {
            background: var(--success-bg);
            border: 1px solid var(--success-border);
            color: var(--success-text);
            padding: 10px 14px;
            border-radius: 6px;
            margin-bottom: 16px;
        }
        .error {
            background: var(--error-bg);
            border: 1px solid var(--error-border);
            color: var(--error-text);
            padding: 10px 14px;
            border-radius: 6px;
            margin-bottom: 16px;
        }
        input, select, textarea {
            width: 100%;
            padding: 10px;
            margin: 6px 0 12px;
            box-sizing: border-box;
            border: 1px solid var(--border);
            border-radius: 5px;
            background: #0f1114;
            color: var(--text);
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--gold);
        }
        label { font-weight: 600; font-size: 13px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
        button, .btn {
            background: var(--gold);
            color: #1a1a1a;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: background 0.2s ease;
        }
        button:hover, .btn:hover { background: var(--gold-hover); }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--border); }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
        .muted { color: var(--text-muted); font-size: 13px; }
        .price { font-weight: 700; color: var(--gold); font-size: 17px; }
    </style>
</head>
<body>
<header>
    <div>
        <span class="brand">CrownMart</span>
        <%
            User navUser = (session == null) ? null : (User) session.getAttribute(AuthFilter.SESSION_USER_ATTR);
            if (navUser != null) {
        %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/cart'/>">Cart</a>
        <a href="<c:url value='/orders'/>">Orders</a>
        <% if (navUser.getRole().name().equals("SELLER")) { %>
        <a href="<c:url value='/products/create'/>">List a Product</a>
        <a href="<c:url value='/orders/seller'/>">My Sales</a>
        <% } %>
        <% if (navUser.getRole().name().equals("ADMIN")) { %>
        <a href="<c:url value='/admin/dashboard'/>">Admin Dashboard</a>
        <% } %>
        <% } %>
    </div>
    <div>
        <% if (navUser != null) { %>
            <span style="margin-right:12px;">Hi, <c:out value="<%= navUser.getName() %>"/> (<%= navUser.getRole() %>)</span>
            <a href="<c:url value='/logout'/>">Log out</a>
        <% } else { %>
            <a href="<c:url value='/login'/>">Log in</a>
            <a href="<c:url value='/register'/>">Register</a>
        <% } %>
    </div>
</header>
<main>
<%
    Object flash = (session == null) ? null : session.getAttribute("flashMessage");
    if (flash != null) {
        session.removeAttribute("flashMessage");
        request.setAttribute("flashMessage", flash);
%>
    <div class="flash"><c:out value="${flashMessage}"/></div>
<% } %>
<c:if test="${not empty errorMessage}">
    <div class="error"><c:out value="${errorMessage}"/></div>
</c:if>