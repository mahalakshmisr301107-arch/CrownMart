<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page import="com.crownmart.app.filter.AuthFilter" %>
<%@ page import="com.crownmart.app.model.User" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CrownMart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f7f4ec;
            --surface: #ffffff;
            --surface-hover: #f0ece0;
            --border: #e3ddcc;
            --border-strong: #d1c8ae;
            --primary: #3e5641;
            --primary-hover: #2d4030;
            --primary-light: #e7ede6;
            --terracotta: #c1743f;
            --terracotta-light: #f6e9dd;
            --gold: #d9a441;
            --text: #24261f;
            --text-muted: #6b6a5c;
            --text-faint: #9a9884;
            --success-bg: #eef4ea;
            --success-border: #c2d9b5;
            --success-text: #3c6b2e;
            --error-bg: #fbeeea;
            --error-border: #e6bfa9;
            --error-text: #a4482a;
            --radius: 6px;
            --radius-sm: 4px;
            --shadow-sm: 0 1px 2px rgba(36, 38, 31, 0.06);
            --shadow-md: 0 4px 14px rgba(36, 38, 31, 0.09);
            --shadow-lg: 0 16px 40px rgba(36, 38, 31, 0.14);
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            margin: 0;
            background: var(--bg);
            color: var(--text);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }
        header {
            background: var(--bg);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
        }
        header a {
            color: var(--text-muted);
            text-decoration: none;
            margin-right: 4px;
            padding: 8px 14px;
            border-radius: var(--radius-sm);
            font-weight: 500;
            font-size: 14px;
            transition: all 0.15s ease;
        }
        header a:hover { color: var(--text); }
        header .brand {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 21px;
            font-weight: 700;
            margin-right: 28px;
            color: var(--text);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }
        header .brand::before {
            content: "C";
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 16px;
            margin-right: 10px;
        }
        .tagline { color: var(--text-faint); font-size: 14px; margin-right: auto; }
        main { max-width: 1100px; margin: 32px auto; padding: 0 20px; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 22px;
            margin-bottom: 16px;
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.2s ease, transform 0.15s ease, border-color 0.2s ease;
        }
        .product-grid .card:hover {
            box-shadow: var(--shadow-md);
            border-color: var(--border-strong);
            transform: translateY(-3px);
        }
        .flash {
            background: var(--success-bg);
            border: 1px solid var(--success-border);
            color: var(--success-text);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
        }
        .error {
            background: var(--error-bg);
            border: 1px solid var(--error-border);
            color: var(--error-text);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
        }
        input, select, textarea {
            width: 100%;
            padding: 12px 14px;
            margin: 6px 0 14px;
            box-sizing: border-box;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-sm);
            background: var(--surface);
            color: var(--text);
            font-family: inherit;
            font-size: 14px;
            transition: border-color 0.15s ease;
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--primary);
        }
        label { font-weight: 600; font-size: 12.5px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
        button, .btn {
            background: var(--primary);
            color: #ffffff;
            border: none;
            padding: 12px 22px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: background 0.15s ease;
            font-family: inherit;
        }
        button:hover, .btn:hover { background: var(--primary-hover); }
        table { width: 100%; border-collapse: collapse; }
        th {
            text-align: left;
            padding: 10px 12px;
            border-bottom: 2px solid var(--border);
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
            font-weight: 700;
            font-family: 'Space Mono', monospace;
        }
        td { text-align: left; padding: 12px; border-bottom: 1px solid var(--border); font-size: 14.5px; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 20px; }
        .muted { color: var(--text-muted); font-size: 13px; }
        .price { font-weight: 700; color: var(--text); font-size: 18px; }
        .price::before { content: "\20B9"; font-weight: 600; margin-right: 1px; opacity: 0.7; }

        h1, h2, h3 { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; }

        .icon-sm { width: 16px; height: 16px; display: inline-block; vertical-align: middle; }
        .icon-lg { width: 26px; height: 26px; display: block; margin: 0 auto 10px; color: var(--primary); }

        .eyebrow {
            display: inline-block;
            color: var(--terracotta);
            font-family: 'Space Mono', monospace;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            margin-bottom: 20px;
        }
        .hero-title {
            font-size: 54px;
            line-height: 1.1;
            font-weight: 700;
            color: var(--text);
            margin: 0 0 20px;
        }
        .hero-subtitle {
            font-size: 17px;
            font-family: 'Inter', sans-serif;
            color: var(--text-muted);
            line-height: 1.65;
            margin-bottom: 30px;
            max-width: 480px;
        }
        .hero-actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
        .btn-outline {
            background: transparent;
            color: var(--primary);
            border: none;
            padding: 12px 0;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-outline:hover { color: var(--primary-hover); }

        .section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 48px 0 20px; flex-wrap: wrap; gap: 8px; }
        .section-heading h2 { font-size: 26px; margin: 0; }
        .section-heading a { color: var(--primary); font-size: 14px; font-weight: 600; text-decoration: none; }

        .category-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; margin-bottom: 8px; }
        .category-tile {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px 16px;
            text-align: center;
            text-decoration: none;
            color: var(--text);
            font-weight: 600;
            font-size: 14px;
            transition: all 0.15s ease;
        }
        .category-tile:hover { border-color: var(--primary); box-shadow: var(--shadow-sm); }
    </style>
</head>
<body>
<header>
    <div style="display:flex; align-items:center;">
        <a href="<c:url value='/'/>" class="brand">CrownMart</a>
        <span class="tagline">Marketplace</span>
    </div>
    <div style="display:flex; align-items:center;">
        <%
            User navUser = (session == null) ? null : (User) session.getAttribute(AuthFilter.SESSION_USER_ATTR);
            if (navUser != null) {
        %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/cart'/>">Cart</a>
        <a href="<c:url value='/orders'/>">Orders</a>
        <% if (navUser.getRole().name().equals("SELLER")) { %>
        <a href="<c:url value='/products/create'/>">List a Product</a>
        <a href="<c:url value='/orders/seller'/>">My Sales</a>
        <% } %>
        <% if (navUser.getRole().name().equals("ADMIN")) { %>
        <a href="<c:url value='/admin/dashboard'/>">Admin Dashboard</a>
        <% } %>
            <span class="muted" style="margin:0 14px;">Hi, <c:out value="<%= navUser.getName() %>"/></span>
            <a href="<c:url value='/logout'/>" style="border:1px solid var(--border-strong); border-radius:var(--radius-sm);">Log out</a>
        <% } else { %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/login'/>" style="border:1px solid var(--border-strong); border-radius:var(--radius-sm); margin-left:8px;">Log in</a>
        <a href="<c:url value='/register'/>" class="btn" style="margin-left:8px;">Join</a>
        <% } %>
    </div>
</header>
<main>
<%
    Object flash = (session == null) ? null : session.getAttribute("flashMessage");
    if (flash != null) {
        session.removeAttribute("flashMessage");
        request.setAttribute("flashMessage", flash);
%>
    <div class="flash"><c:out value="${flashMessage}"/></div>
<% } %>
<c:if test="${not empty errorMessage}">
    <div class="error"><c:out value="${errorMessage}"/></div>
</c:if>