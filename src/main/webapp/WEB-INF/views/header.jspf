<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page import="com.crownmart.app.filter.AuthFilter" %>
<%@ page import="com.crownmart.app.model.User" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CrownMart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f8fafc;
            --surface: #ffffff;
            --surface-hover: #f1f5f9;
            --border: #e2e8f0;
            --border-strong: #cbd5e1;
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --primary-light: #eff6ff;
            --teal: #0d9488;
            --teal-light: #f0fdfa;
            --text: #0f172a;
            --text-muted: #64748b;
            --text-faint: #94a3b8;
            --success-bg: #f0fdf4;
            --success-border: #bbf7d0;
            --success-text: #15803d;
            --error-bg: #fef2f2;
            --error-border: #fecaca;
            --error-text: #b91c1c;
            --radius: 10px;
            --radius-sm: 6px;
            --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.06);
            --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.08);
            --shadow-lg: 0 12px 32px rgba(15, 23, 42, 0.12);
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            margin: 0;
            background: var(--bg);
            color: var(--text);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }
        header {
            background: var(--surface);
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 50;
        }
        header a {
            color: var(--text-muted);
            text-decoration: none;
            margin-right: 4px;
            padding: 8px 14px;
            border-radius: var(--radius-sm);
            font-weight: 500;
            font-size: 14px;
            transition: all 0.15s ease;
        }
        header a:hover { color: var(--text); background: var(--surface-hover); }
        header .brand {
            font-size: 20px;
            font-weight: 800;
            margin-right: 32px;
            color: var(--text);
            letter-spacing: -0.02em;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }
        header .brand::before {
            content: "";
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: linear-gradient(135deg, var(--primary), var(--teal));
            margin-right: 8px;
        }
        main { max-width: 1100px; margin: 32px auto; padding: 0 20px; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 22px;
            margin-bottom: 16px;
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.2s ease, transform 0.15s ease, border-color 0.2s ease;
        }
        .product-grid .card:hover {
            box-shadow: var(--shadow-md);
            border-color: var(--border-strong);
            transform: translateY(-3px);
        }
        .flash {
            background: var(--success-bg);
            border: 1px solid var(--success-border);
            color: var(--success-text);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
        }
        .error {
            background: var(--error-bg);
            border: 1px solid var(--error-border);
            color: var(--error-text);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
        }
        input, select, textarea {
            width: 100%;
            padding: 11px 12px;
            margin: 6px 0 14px;
            box-sizing: border-box;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-sm);
            background: var(--surface);
            color: var(--text);
            font-family: inherit;
            font-size: 14px;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-light);
        }
        label { font-weight: 600; font-size: 12.5px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
        button, .btn {
            background: var(--primary);
            color: #ffffff;
            border: none;
            padding: 11px 22px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: background 0.15s ease, transform 0.1s ease;
            font-family: inherit;
        }
        button:hover, .btn:hover { background: var(--primary-hover); }
        button:active, .btn:active { transform: scale(0.98); }
        table { width: 100%; border-collapse: collapse; }
        th {
            text-align: left;
            padding: 10px 12px;
            border-bottom: 2px solid var(--border);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--text-muted);
            font-weight: 600;
        }
        td { text-align: left; padding: 12px; border-bottom: 1px solid var(--border); font-size: 14.5px; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 20px; }
        .muted { color: var(--text-muted); font-size: 13px; }
        .price { font-weight: 700; color: var(--text); font-size: 18px; }
        .price::before { content: "\20B9"; font-weight: 600; margin-right: 1px; opacity: 0.7; }

        h1, h2, h3 { letter-spacing: -0.02em; font-weight: 700; }

        .icon-sm { width: 16px; height: 16px; display: inline-block; vertical-align: middle; }
        .icon-lg { width: 26px; height: 26px; display: block; margin: 0 auto 10px; color: var(--primary); }

        .hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 56px;
            padding: 72px 20px;
            flex-wrap: wrap;
        }
        .hero-content { flex: 1 1 440px; max-width: 580px; }
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--primary);
            background: var(--primary-light);
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 0.02em;
            padding: 6px 12px;
            border-radius: 999px;
            margin-bottom: 20px;
        }
        .hero-title {
            font-size: 48px;
            line-height: 1.1;
            font-weight: 800;
            color: var(--text);
            margin: 0 0 18px;
        }
        .hero-title .accent {
            background: linear-gradient(135deg, var(--primary), var(--teal));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .hero-subtitle {
            font-size: 17px;
            color: var(--text-muted);
            line-height: 1.65;
            margin-bottom: 30px;
            max-width: 480px;
        }
        .hero-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
        .btn-outline {
            background: var(--surface);
            color: var(--text);
            border: 1px solid var(--border-strong);
            padding: 11px 22px;
            border-radius: var(--radius-sm);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-outline:hover { border-color: var(--text-muted); background: var(--surface-hover); }

        .hero-visual {
            position: relative;
            width: 320px;
            height: 340px;
            flex-shrink: 0;
        }
        .hero-card {
            position: absolute;
            border-radius: var(--radius);
            box-shadow: var(--shadow-lg);
        }
        .hero-card-back {
            background: linear-gradient(135deg, var(--teal), var(--primary));
            width: 240px; height: 300px;
            top: 30px; left: 60px;
            opacity: 0.15;
        }
        .hero-card-front {
            background: var(--surface);
            border: 1px solid var(--border);
            width: 280px; height: 320px;
            top: 0; left: 20px;
            padding: 26px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .hero-card-front .tag {
            color: var(--teal);
            background: var(--teal-light);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            padding: 5px 10px;
            border-radius: 999px;
            display: inline-block;
            width: fit-content;
        }
        .hero-card-front .headline {
            font-size: 20px;
            font-weight: 700;
            color: var(--text);
            line-height: 1.35;
        }
        .hero-card-front .caption { color: var(--text-muted); font-size: 13px; }

        .stats-bar {
            display: flex;
            gap: 40px;
            flex-wrap: wrap;
            padding: 28px 20px;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            margin-bottom: 40px;
        }
        .stat-item { display: flex; flex-direction: column; }
        .stat-number { font-size: 26px; font-weight: 800; color: var(--text); }
        .stat-label { font-size: 13px; color: var(--text-muted); }

        .section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 48px 0 20px; flex-wrap: wrap; gap: 8px; }
        .section-heading h2 { font-size: 24px; margin: 0; }
        .section-heading a { color: var(--primary); font-size: 14px; font-weight: 600; text-decoration: none; }

        .category-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; margin-bottom: 8px; }
        .category-tile {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px 16px;
            text-align: center;
            text-decoration: none;
            color: var(--text);
            font-weight: 600;
            font-size: 14px;
            transition: all 0.15s ease;
        }
        .category-tile:hover { border-color: var(--primary); box-shadow: var(--shadow-sm); transform: translateY(-2px); }
    </style>
</head>
<body>
<header>
    <div style="display:flex; align-items:center;">
        <a href="<c:url value='/'/>" class="brand">CrownMart</a>
        <%
            User navUser = (session == null) ? null : (User) session.getAttribute(AuthFilter.SESSION_USER_ATTR);
            if (navUser != null) {
        %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/cart'/>">Cart</a>
        <a href="<c:url value='/orders'/>">Orders</a>
        <% if (navUser.getRole().name().equals("SELLER")) { %>
        <a href="<c:url value='/products/create'/>">List a Product</a>
        <a href="<c:url value='/orders/seller'/>">My Sales</a>
        <% } %>
        <% if (navUser.getRole().name().equals("ADMIN")) { %>
        <a href="<c:url value='/admin/dashboard'/>">Admin Dashboard</a>
        <% } %>
        <% } else { %>
        <a href="<c:url value='/products'/>">Browse</a>
        <% } %>
    </div>
    <div>
        <% if (navUser != null) { %>
            <span class="muted" style="margin-right:14px;">Hi, <c:out value="<%= navUser.getName() %>"/> &middot; <%= navUser.getRole() %></span>
            <a href="<c:url value='/logout'/>">Log out</a>
        <% } else { %>
            <a href="<c:url value='/login'/>">Log in</a>
            <a href="<c:url value='/register'/>" class="btn" style="margin-left:8px;">Sign up</a>
        <% } %>
    </div>
</header>
<main>
<%
    Object flash = (session == null) ? null : session.getAttribute("flashMessage");
    if (flash != null) {
        session.removeAttribute("flashMessage");
        request.setAttribute("flashMessage", flash);
%>
    <div class="flash"><c:out value="${flashMessage}"/></div>
<% } %>
<c:if test="${not empty errorMessage}">
    <div class="error"><c:out value="${errorMessage}"/></div>
</c:if>