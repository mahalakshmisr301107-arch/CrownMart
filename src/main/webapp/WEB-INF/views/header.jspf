<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page import="com.crownmart.app.filter.AuthFilter" %>
<%@ page import="com.crownmart.app.model.User" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CrownMart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f3ead8;
            --surface: #faf5e9;
            --surface-hover: #ede2cb;
            --border: #e0d3b8;
            --border-strong: #cdbd9c;
            --brass: #9a6a24;
            --brass-hover: #7f551a;
            --brass-light: #efe3c8;
            --on-accent: #ffffff;
            --text: #2b241a;
            --text-muted: #6b5f4b;
            --text-faint: #8f836d;
            --success-bg: #e9f0dd;
            --success-border: #b9cf9c;
            --success-text: #3f6b22;
            --error-bg: #f7e4dd;
            --error-border: #e0b3a5;
            --error-text: #a3392a;
            --radius: 8px;
            --radius-sm: 5px;
            --shadow-sm: 0 1px 3px rgba(80, 60, 20, 0.10);
            --shadow-md: 0 8px 20px rgba(80, 60, 20, 0.15);
            --shadow-lg: 0 20px 50px rgba(80, 60, 20, 0.20);
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            margin: 0;
            background: var(--bg);
            color: var(--text);
            line-height: 1.55;
            -webkit-font-smoothing: antialiased;
        }
        header {
            background: var(--bg);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 50;
        }
        header a {
            color: var(--text-muted);
            text-decoration: none;
            margin-right: 4px;
            padding: 8px 14px;
            border-radius: var(--radius-sm);
            font-weight: 500;
            font-size: 14px;
            transition: all 0.15s ease;
        }
        header a:hover { color: var(--brass); }
        header .brand {
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: 24px;
            font-weight: 400;
            margin-right: 32px;
            color: var(--text);
            letter-spacing: 0.01em;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }
        header .brand::before {
            content: "C";
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #b8843a, #8a5d1f);
            color: #ffffff;
            font-family: 'DM Serif Display', serif;
            font-weight: 400;
            font-size: 17px;
            margin-right: 12px;
        }
        .tagline { color: var(--text-faint); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; margin-right: auto; }
        main { max-width: 1100px; margin: 32px auto; padding: 0 20px; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 22px;
            margin-bottom: 16px;
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.2s ease, transform 0.15s ease, border-color 0.2s ease;
        }
        .product-grid .card:hover {
            box-shadow: var(--shadow-md);
            border-color: var(--brass);
            transform: translateY(-3px);
        }
        .flash {
            background: var(--success-bg);
            border: 1px solid var(--success-border);
            color: var(--success-text);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
        }
        .error {
            background: var(--error-bg);
            border: 1px solid var(--error-border);
            color: var(--error-text);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
        }
        input, select, textarea {
            width: 100%;
            padding: 11px 12px;
            margin: 6px 0 14px;
            box-sizing: border-box;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-sm);
            background: #fffdf7;
            color: var(--text);
            font-family: inherit;
            font-size: 14px;
            transition: border-color 0.15s ease;
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--brass);
        }
        label { font-weight: 600; font-size: 12.5px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
        button, .btn {
            background: var(--brass);
            color: var(--on-accent);
            border: none;
            padding: 12px 24px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            display: inline-block;
            transition: background 0.15s ease, transform 0.1s ease;
            font-family: inherit;
        }
        button:hover, .btn:hover { background: var(--brass-hover); }
        button:active, .btn:active { transform: scale(0.98); }
        table { width: 100%; border-collapse: collapse; }
        th {
            text-align: left;
            padding: 10px 12px;
            border-bottom: 2px solid var(--border-strong);
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            font-weight: 700;
        }
        td { text-align: left; padding: 12px; border-bottom: 1px solid var(--border); font-size: 14.5px; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 20px; }
        .muted { color: var(--text-muted); font-size: 13px; }
        .price { font-weight: 700; color: var(--brass); font-size: 18px; }
        .price::before { content: "\20B9"; font-weight: 600; margin-right: 1px; opacity: 0.8; }

        h1, h2, h3 { font-family: 'DM Serif Display', Georgia, serif; font-weight: 400; }

        .icon-sm { width: 16px; height: 16px; display: inline-block; vertical-align: middle; }
        .icon-lg { width: 26px; height: 26px; display: block; margin: 0 auto 10px; color: var(--brass); }

        .eyebrow {
            display: inline-block;
            color: var(--brass);
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            margin-bottom: 22px;
            position: relative;
            padding-left: 28px;
        }
        .eyebrow::before {
            content: "";
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 20px;
            height: 1px;
            background: var(--brass);
        }
        .hero-title {
            font-size: 58px;
            line-height: 1.1;
            font-weight: 400;
            color: var(--text);
            margin: 0 0 22px;
        }
        .hero-title .accent { color: var(--brass); font-style: italic; }
        .hero-subtitle {
            font-size: 17px;
            font-family: 'DM Sans', sans-serif;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 32px;
            max-width: 480px;
        }
        .hero-actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
        .btn-outline {
            background: transparent;
            color: var(--brass);
            border: 1px solid var(--border-strong);
            padding: 11px 24px;
            border-radius: var(--radius-sm);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-outline:hover { border-color: var(--brass); background: var(--brass-light); }

        .section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 56px 0 22px; flex-wrap: wrap; gap: 8px; }
        .section-heading h2 { font-size: 30px; margin: 0; }
        .section-heading a { color: var(--brass); font-size: 14px; font-weight: 600; text-decoration: none; }

        .category-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; margin-bottom: 8px; }
        .category-tile {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 26px 16px;
            text-align: center;
            text-decoration: none;
            color: var(--text);
            font-weight: 600;
            font-size: 14px;
            transition: all 0.15s ease;
        }
        .category-tile:hover { border-color: var(--brass); box-shadow: var(--shadow-sm); transform: translateY(-2px); }
    </style>
</head>
<body>
<header>
    <div style="display:flex; align-items:center;">
        <a href="<c:url value='/'/>" class="brand">CrownMart</a>
        <span class="tagline">Marketplace</span>
    </div>
    <div style="display:flex; align-items:center;">
        <%
            User navUser = (session == null) ? null : (User) session.getAttribute(AuthFilter.SESSION_USER_ATTR);
            if (navUser != null) {
        %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/cart'/>">Cart</a>
        <a href="<c:url value='/orders'/>">Orders</a>
        <% if (navUser.getRole().name().equals("SELLER")) { %>
        <a href="<c:url value='/products/create'/>">List a Product</a>
        <a href="<c:url value='/orders/seller'/>">My Sales</a>
        <% } %>
        <% if (navUser.getRole().name().equals("ADMIN")) { %>
        <a href="<c:url value='/admin/dashboard'/>">Admin Dashboard</a>
        <% } %>
            <span class="muted" style="margin:0 14px;">Hi, <c:out value="<%= navUser.getName() %>"/></span>
            <a href="<c:url value='/logout'/>" style="border:1px solid var(--border-strong); border-radius:var(--radius-sm);">Log out</a>
        <% } else { %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/login'/>" style="border:1px solid var(--border-strong); border-radius:var(--radius-sm); margin-left:8px;">Log in</a>
        <a href="<c:url value='/register'/>" class="btn" style="margin-left:8px;">Join</a>
        <% } %>
    </div>
</header>
<main>
<%
    Object flash = (session == null) ? null : session.getAttribute("flashMessage");
    if (flash != null) {
        session.removeAttribute("flashMessage");
        request.setAttribute("flashMessage", flash);
%>
    <div class="flash"><c:out value="${flashMessage}"/></div>
<% } %>
<c:if test="${not empty errorMessage}">
    <div class="error"><c:out value="${errorMessage}"/></div>
</c:if>